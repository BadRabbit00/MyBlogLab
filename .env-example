# Copy to .env and fill locally. Never commit a real token.
# Token itself goes in ./secrets/telegram_bot_token, not in this file.
TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token

# Required: your numeric Telegram user ID; multiple owners: 123456789,987654321.
# Startup fails if empty. Only private chats with these users can control the bot.
TELEGRAM_ALLOWED_USER_IDS=

# llama-server native /completion endpoint (not /v1/chat/completions).
# compose.yaml maps host.docker.internal to the Docker host.
LLM_ENDPOINT=http://host.docker.internal:8080/completion

# Persistent data directory inside the container.
BLOG_DATA_DIR=/data
LOG_LEVEL=INFO
